# Project-internal agent/IDE data — must not be published to pub.dev.
.codebuddy/

# Release/notes files that are repo-internal, not package content.
wiki/
TODO.md
AGENTS.md
CONTRIBUTING.md

# Local build artifacts (test caches, native assets) — not needed by consumers.
build/

# Dev-only scripts (normalize-eol, check_release) live in tools/ and are repo-internal
# tooling, NOT part of the published package. The build helper is published instead as a
# Dart bin/ executable (bin/build_inspector.dart) and is intentionally NOT excluded.
tools/

# Nextra documentation site source — compiled and published to gh-pages by CI, never part of the package.
website/

# Consumer-facing package should not ship tests, generated docs, or IDE files.
# (example/ is kept so pub.dev still renders the Example tab; image/screenshot/ is kept
#  because pubspec.yaml `screenshots` references those files and pub.dev requires them in the archive.)
test/
docs/
image/mascot/
*.iml
